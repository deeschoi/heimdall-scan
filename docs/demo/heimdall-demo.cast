[2.221003, "o", "\u001b[1;36m$ heimdall eval vulnapp\u001b[0m\r\n"]
[7.674091, "o", "\u001b[3m         eval: vulnapp         \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mmetric         \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mvalue    \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━┩\r\n│ precision       │ 1.000     │\r\n│ recall          │ 1.000     │\r\n│ f1              │ 1.000     │\r\n│ TP / FP / FN    │ 7 / 0 / 0 │\r\n│ safe-target FPs │ 0         │\r\n└─────────────────┴───────────┘\r\n"]
