[0.017157, "o", "\u001b[1;33m# Heimdall: find -> prove -> patch, against the project's own vulnerable target\u001b[0m\r\n\r\n"]
[1.02321, "o", "\u001b[1;36m$ heimdall list-checks\u001b[0m\r\n"]
[1.198515, "o", "\u001b[3m                                           Heimdall checks                                           \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━┳━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mid             \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mtitle                           \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mCWE    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mOWASP API\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mWSTG        \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mASVS  \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━╇━━━━━━━━┩\r\n│ bola            │ Broken object level       "]
[1.19852, "o", "       │ CWE-639 │ API1:2023 │ WSTG-ATHZ-04 │ 4.2.1  │\r\n│                 │ authorization (IDOR)             │         │           │              │        │\r\n│ exposure        │ Excessive data exposure of       │ CWE-200 │ API3:2023 │ WSTG-ATHZ-04 │ 8.3.4  │\r\n│                 │ sensitive fields                 │         │           │              │        │\r\n│ jwt             │ Weak or forgeable JWT            │ CWE-347 │ API2:2023 │ WSTG-SESS-10 │ 3.5.3  │\r\n│ mass_assignment │ Mass assignment enables          │ CWE-915 │ API6:2023 │ WSTG-BUSL-08 │ 5.1.2  │\r\n│                 │ privilege escalation             │         │           │              │        │\r\n│ sqli            │ Error-based SQL injection        │ CWE-89  │ API8:2023 │ WSTG-INPV-05 │ 5.3.4  │\r\n│ ssrf            │ Server-side request forgery      │ CWE-918 │ API7:2023 │ WSTG-INPV-19 │ 12.6.1 │\r\n└─────────"]
